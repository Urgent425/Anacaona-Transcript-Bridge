# This repo has a pre-existing peer-dependency conflict: @commitlint (pulled
# in via the "ui" / shadcn devDependency) requires an older typescript peer
# range than i18next does. legacy-peer-deps tells npm to resolve peer deps
# the way npm 6 did (warn instead of hard-fail), which is what the local
# --legacy-peer-deps flag was doing manually. This makes plain `npm install`
# (e.g. on Vercel) behave the same as the local install.
legacy-peer-deps=true
